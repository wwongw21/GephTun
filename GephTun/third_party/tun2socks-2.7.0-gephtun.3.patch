+func TestAuditCompletedSOCKSHandshakeLeavesConnectionUsable(t *testing.T) {
+	listener, err := net.Listen("tcp4", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { listener.Close() })
+	serverDone := make(chan error, 1)
+	go func() {
+		peer, e := listener.Accept()
+		if e != nil {
+			serverDone <- e
+			return
+		}
+		defer peer.Close()
+		peer.SetDeadline(time.Now().Add(2 * time.Second))
+		greeting := make([]byte, 3)
+		if _, e = io.ReadFull(peer, greeting); e != nil {
+			serverDone <- e
+			return
+		}
+		if _, e = peer.Write([]byte{5, 0}); e != nil {
+			serverDone <- e
+			return
+		}
+		request := make([]byte, 10)
+		if _, e = io.ReadFull(peer, request); e != nil {
+			serverDone <- e
+			return
+		}
+		if _, e = peer.Write([]byte{5, 0, 0, 1, 0, 0, 0, 0, 0, 0}); e != nil {
+			serverDone <- e
+			return
+		}
+		payload := make([]byte, 4)
+		if _, e = io.ReadFull(peer, payload); e == nil {
+			_, e = peer.Write(payload)
+		}
+		serverDone <- e
+	}()
+	ss, err := New(listener.Addr().String(), "", "")
+	if err != nil {
+		t.Fatal(err)
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), 80*time.Millisecond)
+	defer cancel()
+	client, err := ss.DialContext(ctx, &M.Metadata{Network: M.TCP, DstIP: netip.MustParseAddr("192.0.2.1"), DstPort: 443})
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { client.Close() })
+	cancel()
+	time.Sleep(100 * time.Millisecond)
+	if _, err = client.Write([]byte("ping")); err != nil {
+		t.Fatalf("completed connection retained handshake cancellation/deadline: %v", err)
+	}
+	payload := make([]byte, 4)
+	if _, err = io.ReadFull(client, payload); err != nil || string(payload) != "ping" {
+		t.Fatalf("completed connection unusable: payload=%q err=%v", payload, err)
+	}
+	if err = <-serverDone; err != nil {
+		t.Fatal(err)
+	}
+}
