+func TestAuditConstructorRejectsShortEndpoints(t *testing.T) {
+	for _, addr := range []string{"", "x"} {
+		t.Run(addr, func(t *testing.T) {
+			defer func() {
+				if v := recover(); v != nil {
+					t.Errorf("constructor panicked for short endpoint %q: %v", addr, v)
+				}
+			}()
+			_, err := New(addr, "", "")
+			if err == nil {
+				t.Errorf("invalid short endpoint %q did not return error", addr)
+			}
+		})
+	}
+}
+
+func TestAuditSOCKSHandshakeRespectsContextCancellation(t *testing.T) {
+	listener, err := net.Listen("tcp4", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { listener.Close() })
+	accepted := make(chan net.Conn, 1)
+	go func() {
+		c, e := listener.Accept()
+		if e == nil {
+			accepted <- c
+		}
+	}()
+	ss, err := New(listener.Addr().String(), "", "")
+	if err != nil {
+		t.Fatal(err)
+	}
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	result := make(chan error, 1)
+	go func() {
+		c, e := ss.DialContext(ctx, &M.Metadata{Network: M.TCP, DstIP: netip.MustParseAddr("192.0.2.1"), DstPort: 443})
+		if c != nil {
+			c.Close()
+		}
+		result <- e
+	}()
+	var peer net.Conn
+	select {
+	case peer = <-accepted:
+	case <-time.After(time.Second):
+		t.Fatal("proxy connection not accepted")
+	}
+	t.Cleanup(func() { peer.Close() })
+	// Cancel only after TCP connects, to exercise the pending SOCKS response.
+	cancel()
+	select {
+	case e := <-result:
+		if e == nil {
+			t.Fatal("canceled handshake returned success")
+		}
+	case <-time.After(500 * time.Millisecond):
+		peer.Close()
+		<-result
+		t.Fatal("SOCKS handshake remained blocked after its context was canceled")
+	}
+}
+
+func TestAuditConstructorPreservesSupportedEndpoints(t *testing.T) {
+	for _, item := range []struct {
+		input, want string
+		unix        bool
+	}{
+		{"127.0.0.1:1080", "127.0.0.1:1080", false},
+		{"[::1]:1080", "[::1]:1080", false},
+		{"/tmp/proxy.sock", "/tmp/proxy.sock", true},
+		{"/@proxy", "@proxy", true},
+		{"/\x00proxy", "\x00proxy", true},
+	} {
+		ss, err := New(item.input, "", "")
+		if err != nil || ss.addr != item.want || ss.unix != item.unix {
+			t.Fatalf("supported endpoint %q changed: proxy=%+v err=%v", item.input, ss, err)
+		}
+	}
+}
