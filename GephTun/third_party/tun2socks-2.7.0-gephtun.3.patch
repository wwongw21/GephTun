+func TestGephTunConcurrentTCPFragmentedRepliesAndData(t *testing.T) {
+	const clients = 64
+	server := newAuditServer(t, func(c net.Conn) {
+		cmd, err := auditServerRequest(c)
+		if err != nil || cmd != 1 {
+			return
+		}
+		for _, b := range []byte{5, 0, 0, 1, 0, 0, 0, 0, 0, 0} {
+			if _, err := c.Write([]byte{b}); err != nil {
+				return
+			}
+		}
+		io.Copy(c, c)
+	})
+	ss, _ := New(server.listener.Addr().String(), "", "")
+	results := make(chan error, clients)
+	for i := 0; i < clients; i++ {
+		go func(id int) {
+			ctx, cancel := context.WithTimeout(context.Background(), 2*time.Second)
+			c, err := ss.DialContext(ctx, auditMetadata())
+			cancel()
+			if err != nil {
+				results <- err
+				return
+			}
+			defer c.Close()
+			c.SetDeadline(time.Now().Add(2 * time.Second))
+			payload := []byte(fmt.Sprintf("client-%03d", id))
+			if _, err = c.Write(payload); err != nil {
+				results <- err
+				return
+			}
+			reply := make([]byte, len(payload))
+			_, err = io.ReadFull(c, reply)
+			if err == nil && !bytes.Equal(payload, reply) {
+				err = fmt.Errorf("TCP payload mismatch")
+			}
+			results <- err
+		}(i)
+	}
+	for i := 0; i < clients; i++ {
+		if err := <-results; err != nil {
+			t.Fatal(err)
+		}
+	}
+	server.waitIdle(t)
+	t.Logf("%d concurrent TCP streams accepted fragmented replies and exchanged data after dial context cancellation", clients)
+}
