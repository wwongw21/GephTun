+func TestGephTunDatagramMutationBounds(t *testing.T) {
+	const cases = 100000
+	rng := rand.New(rand.NewSource(17092026))
+	relay := &net.UDPAddr{IP: net.IP{127, 0, 0, 1}, Port: 43210}
+	buf := make([]byte, 512)
+	for i := 0; i < cases; i++ {
+		size := rng.Intn(256)
+		packet := make([]byte, size)
+		rng.Read(packet)
+		if i%3 == 0 && size >= 10 {
+			packet[0] = 0
+			packet[1] = 0
+			packet[2] = 0
+			packet[3] = 1
+		}
+		rng.Read(buf)
+		pc := &socksPacketConn{PacketConn: &scriptedPacketConn{queue: []queuedDatagram{{packet, relay}}}, rAddr: relay}
+		n, from, err := pc.ReadFrom(buf)
+		if n < 0 || n > len(packet) || n > len(buf) {
+			t.Fatalf("invalid count %d for packet length %d", n, len(packet))
+		}
+		if err != nil && n != 0 {
+			t.Fatalf("error returned nonzero count %d", n)
+		}
+		if err == nil && from == nil {
+			t.Fatal("successful datagram has no source")
+		}
+	}
+	t.Logf("%d deterministic datagram mutations stayed within current-packet bounds", cases)
+}
