+func clientHandshake(ctx context.Context, c net.Conn, addr socks5.Addr, command socks5.Command, user *socks5.User) (socks5.Addr, error) {
+	ctx, cancel := context.WithTimeout(ctx, utils.TCPConnectTimeout)
