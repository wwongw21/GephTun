+package socks5
+
+import (
+	"bytes"
+	"context"
+	"errors"
+	"fmt"
+	"io"
+	"math/rand"
+	"net"
+	"net/netip"
+	"os"
+	"runtime"
+	"sync"
+	"testing"
+	"time"
+
+	M "github.com/xjasonlyu/tun2socks/v2/metadata"
+	wire "github.com/xjasonlyu/tun2socks/v2/transport/socks5"
+)
+
+type auditServer struct {
+	listener net.Listener
+	mu       sync.Mutex
+	peers    map[string]net.Conn
+	workers  sync.WaitGroup
+	stopped  chan struct{}
+	once     sync.Once
+}
+
+func newAuditServer(t *testing.T, handler func(net.Conn)) *auditServer {
+	t.Helper()
+	ln, err := net.Listen("tcp4", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	s := &auditServer{listener: ln, peers: make(map[string]net.Conn), stopped: make(chan struct{})}
+	go func() {
+		defer close(s.stopped)
+		for {
+			c, err := ln.Accept()
+			if err != nil {
+				return
+			}
+			key := c.RemoteAddr().String()
+			s.mu.Lock()
+			s.peers[key] = c
+			s.mu.Unlock()
+			s.workers.Add(1)
+			go func() {
+				defer s.workers.Done()
+				defer c.Close()
+				defer func() { s.mu.Lock(); delete(s.peers, key); s.mu.Unlock() }()
+				c.SetDeadline(time.Now().Add(5 * time.Second))
+				handler(c)
+			}()
+		}
+	}()
+	t.Cleanup(s.close)
+	return s
+}
+func (s *auditServer) close() {
+	s.once.Do(func() {
+		s.listener.Close()
+		<-s.stopped
+		s.mu.Lock()
+		for _, c := range s.peers {
+			c.Close()
+		}
+		s.mu.Unlock()
+		s.workers.Wait()
+	})
+}
+func (s *auditServer) closePeer(key string) bool {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	c, ok := s.peers[key]
+	if ok {
+		c.Close()
+	}
+	return ok
+}
+func (s *auditServer) active() int { s.mu.Lock(); defer s.mu.Unlock(); return len(s.peers) }
+func (s *auditServer) waitIdle(t *testing.T) {
+	t.Helper()
+	until := time.Now().Add(2 * time.Second)
+	for s.active() != 0 && time.Now().Before(until) {
+		time.Sleep(time.Millisecond)
+	}
+	if n := s.active(); n != 0 {
+		t.Fatalf("%d server sockets remained after clients finished", n)
+	}
+}
+func auditServerRequest(c net.Conn) (byte, error) {
+	greeting := make([]byte, 3)
+	if _, err := io.ReadFull(c, greeting); err != nil {
+		return 0, err
+	}
+	if !bytes.Equal(greeting, []byte{5, 1, 0}) {
+		return 0, fmt.Errorf("unexpected greeting %x", greeting)
+	}
+	if _, err := c.Write([]byte{5, 0}); err != nil {
+		return 0, err
+	}
+	header := make([]byte, 3)
+	if _, err := io.ReadFull(c, header); err != nil {
+		return 0, err
+	}
+	if _, err := wire.ReadAddr(c, make([]byte, wire.MaxAddrLen)); err != nil {
+		return 0, err
+	}
+	return header[1], nil
+}
+func auditMetadata() *M.Metadata {
+	return &M.Metadata{Network: M.TCP, DstIP: netip.MustParseAddr("192.0.2.5"), DstPort: 443}
+}
+func auditFDCount() int {
+	if runtime.GOOS != "linux" {
+		return -1
+	}
+	entries, err := os.ReadDir("/proc/self/fd")
+	if err != nil {
+		return -1
+	}
+	return len(entries)
+}
