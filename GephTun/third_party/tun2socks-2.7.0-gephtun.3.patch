+func TestGephTunConcurrentUDPAssociationsAndControlClose(t *testing.T) {
+	const clients = 64
+	const packets = 8
+	relay, err := net.ListenPacket("udp4", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	done := make(chan struct{})
+	go func() {
+		defer close(done)
+		buf := make([]byte, 65535)
+		for {
+			n, from, err := relay.ReadFrom(buf)
+			if err != nil {
+				return
+			}
+			if _, err = relay.WriteTo(buf[:n], from); err != nil {
+				return
+			}
+		}
+	}()
+	t.Cleanup(func() { relay.Close(); <-done })
+	server := newAuditServer(t, func(c net.Conn) {
+		cmd, err := auditServerRequest(c)
+		if err != nil || cmd != 3 {
+			return
+		}
+		if _, err = c.Write(append([]byte{5, 0, 0}, wire.ParseAddr(relay.LocalAddr())...)); err != nil {
+			return
+		}
+		io.Copy(io.Discard, c)
+	})
+	ss, _ := New(server.listener.Addr().String(), "", "")
+	results := make(chan error, clients)
+	target := &net.UDPAddr{IP: net.IP{192, 0, 2, 5}, Port: 443}
+	for i := 0; i < clients; i++ {
+		go func(id int) {
+			pc, err := ss.DialUDP(auditMetadata())
+			if err != nil {
+				results <- err
+				return
+			}
+			defer pc.Close()
+			pc.SetDeadline(time.Now().Add(3 * time.Second))
+			buf := make([]byte, 256)
+			for seq := 0; seq < packets; seq++ {
+				payload := []byte(fmt.Sprintf("client-%03d-packet-%02d", id, seq))
+				n, err := pc.WriteTo(payload, target)
+				if err != nil || n != len(payload) {
+					results <- fmt.Errorf("UDP send count=%d err=%v", n, err)
+					return
+				}
+				n, from, err := pc.ReadFrom(buf)
+				if err != nil || from.String() != target.String() || !bytes.Equal(payload, buf[:n]) {
+					results <- fmt.Errorf("UDP receive mismatch n=%d err=%v", n, err)
+					return
+				}
+			}
+			if id%2 == 0 {
+				control := pc.(*socksPacketConn).tcpConn
+				if !server.closePeer(control.LocalAddr().String()) {
+					results <- fmt.Errorf("server control socket vanished")
+					return
+				}
+			} else {
+				pc.Close()
+			}
+			pc.SetReadDeadline(time.Now().Add(time.Second))
+			_, _, err = pc.ReadFrom(buf)
+			if !errors.Is(err, net.ErrClosed) {
+				results <- fmt.Errorf("UDP survived control/owner close: %v", err)
+				return
+			}
+			results <- nil
+		}(i)
+	}
+	for i := 0; i < clients; i++ {
+		if err := <-results; err != nil {
+			t.Fatal(err)
+		}
+	}
+	server.waitIdle(t)
+	t.Logf("%d UDP associations, %d datagram round trips; server control close and caller close both released associations", clients, clients*packets)
+}
