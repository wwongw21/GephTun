+func TestGephTunInvalidUDPBindingReleasesResources(t *testing.T) {
+	server := newAuditServer(t, func(c net.Conn) {
+		cmd, err := auditServerRequest(c)
+		if err != nil || cmd != 3 {
+			return
+		}
+		reply := append([]byte{5, 0, 0}, wire.SerializeAddr("relay.invalid", netip.Addr{}, 1080)...)
+		if _, err = c.Write(reply); err != nil {
+			return
+		}
+		io.Copy(io.Discard, c)
+	})
+	ss, _ := New(server.listener.Addr().String(), "", "")
+	runtime.GC()
+	beforeFD := auditFDCount()
+	beforeGo := runtime.NumGoroutine()
+	const requests = 128
+	results := make(chan error, requests)
+	for i := 0; i < requests; i++ {
+		go func() {
+			pc, err := ss.DialUDP(auditMetadata())
+			if pc != nil {
+				pc.Close()
+			}
+			if err == nil {
+				err = fmt.Errorf("unsupported UDP binding accepted")
+			} else {
+				err = nil
+			}
+			results <- err
+		}()
+	}
+	for i := 0; i < requests; i++ {
+		if err := <-results; err != nil {
+			t.Fatal(err)
+		}
+	}
+	server.waitIdle(t)
+	until := time.Now().Add(2 * time.Second)
+	for time.Now().Before(until) {
+		if runtime.NumGoroutine() <= beforeGo+2 && (beforeFD < 0 || auditFDCount() <= beforeFD) {
+			break
+		}
+		time.Sleep(time.Millisecond)
+	}
+	afterFD := auditFDCount()
+	afterGo := runtime.NumGoroutine()
+	if beforeFD >= 0 && afterFD > beforeFD {
+		t.Fatalf("UDP binding failures leaked descriptors: before=%d after=%d", beforeFD, afterFD)
+	}
+	if afterGo > beforeGo+2 {
+		t.Fatalf("UDP binding failures left goroutines: before=%d after=%d", beforeGo, afterGo)
+	}
+	t.Logf("%d simultaneous failed associations: descriptors %d -> %d, goroutines %d -> %d", requests, beforeFD, afterFD, beforeGo, afterGo)
+}
