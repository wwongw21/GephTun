+func TestAuditSOCKSHandshakeRespectsContextDeadline(t *testing.T) {
+	listener, err := net.Listen("tcp4", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { listener.Close() })
+	accepted := make(chan net.Conn, 1)
+	go func() {
+		c, e := listener.Accept()
+		if e == nil {
+			accepted <- c
+		}
+	}()
+	ss, err := New(listener.Addr().String(), "", "")
+	if err != nil {
+		t.Fatal(err)
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), 80*time.Millisecond)
+	defer cancel()
+	result := make(chan error, 1)
+	go func() {
+		c, e := ss.DialContext(ctx, &M.Metadata{Network: M.TCP, DstIP: netip.MustParseAddr("192.0.2.1"), DstPort: 443})
+		if c != nil {
+			c.Close()
+		}
+		result <- e
+	}()
+	var peer net.Conn
+	select {
+	case peer = <-accepted:
+	case <-time.After(time.Second):
+		t.Fatal("proxy connection not accepted")
+	}
+	t.Cleanup(func() { peer.Close() })
+	select {
+	case e := <-result:
+		if e == nil {
+			t.Fatal("expired handshake returned success")
+		}
+	case <-time.After(time.Second):
+		peer.Close()
+		<-result
+		t.Fatal("SOCKS handshake exceeded its context deadline")
